# Frontend Environment Variables
# Only public, browser-safe values belong here — every NEXT_PUBLIC_ value is
# inlined into the client bundle. Never put secrets in this file.

# Backend origin used by the same-origin rewrite /api/backend/* (next.config.js).
# Evaluated at BUILD time: on Vercel set it before deploying and redeploy after
# changing it. Example: https://internpath-api.onrender.com (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Login-page demo-account helper (fills demo EMAILS only, never passwords).
# Local presentations only; leave unset on any public deployment.
NEXT_PUBLIC_DEMO_NOTICE_ENABLED=true

# Site-wide "InternPath Demonstration" notice for the hosted academic demo.
# Set to exactly true on the Vercel demonstration project; unset elsewhere.
# NEXT_PUBLIC_DEMO_INSTANCE=true
