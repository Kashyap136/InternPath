# Backend Environment Variables (placeholders only — never commit real credentials)
#
# Separate environments (Phase 5, Step F):
#   - .env (untracked)      -> personal development database (never committed)
#   - TEST_DATABASE_URL     -> dedicated integration-test database, set at test
#                              time ONLY (passes through vitest.config.ts into
#                              src/test-db.ts). NEVER set it in this file: the
#                              guard must stay fail-closed when it is absent.
#   - Production            -> configured in the deployment environment
#                              (hosting provider secrets), never in the repo.
#
# Database URL format (Supabase PostgreSQL):
#   postgresql://<role>:<password>@<host>:<port>/<database>
#
# DATABASE_URL — the application database. For a FRESH project, this points at
# the new isolated development database created per the Phase-5 procedure doc
# (see docs/07-final/... / docs/06-testing/Integration_Test_Environment_Setup.md).
# Migrations (prisma migrate deploy/dev) and integration tests never target a
# production value of this variable.
#
# Pooling note: prisma migrate/prisma db seed need a DIRECT (session) connection
# — for Supabase use the direct port (project host without "-pooler", port 5432).
# For the app's runtime connection through transaction-pooling (PgBouncer), most
# Node.js stacks work on the pooled endpoint (port 6543); document whichever is
# configured per environment. Never expose pooled-vs-direct confusion inside
# test configuration — TEST_DATABASE_URL must be the direct connection.
DATABASE_URL="postgresql://app_user:REPLACE_ME_PASSWORD@127.0.0.1:5432/internpath_dev"

# HTTP server
PORT="4000"
NODE_ENV="development"

# Authentication / sessions (generate real secrets for anything shared:
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# P2-12 note: only COOKIE_SECRET is read at runtime (cookie signing config).
# SESSION_TIMEOUT is NOT read — the inactivity timeout comes from the
# PlatformSetting table (key: sessionInactivityTimeout). JWT_SECRET is parsed
# by the config schema for validation but sessions do not use JWTs.
SESSION_TIMEOUT="3600"
JWT_SECRET="REPLACE_ME_WITH_RANDOM_SECRET"
COOKIE_SECRET="REPLACE_ME_WITH_RANDOM_SECRET"

# CORS
FRONTEND_URL="http://localhost:3000"

# Rate limiting (production default 100; vitest raises it in the test process)
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# UI demo notice (ASM-CAND-022) — REMOVED 2026-11-17: this backend variable
# was never read at runtime and the DB setting demoNoticeEnabled no longer
# exists (public-product transformation: static demo messaging removed from
# the UI; the login demo helper is governed solely by the FRONTEND build
# variable NEXT_PUBLIC_DEMO_NOTICE_ENABLED in the demo environment).

# Transactional email (public-release hardening 2026-11-17).
# Fail-closed: when SMTP_HOST or EMAIL_FROM is unset the mailer is an honest
# no-op (companion emails are skipped and logged as email_disabled) and no
# user flow depends on delivery. Delivery itself is NOT VERIFIED until an
# operator configures a real provider and smoke-tests it.
# For Supabase/other providers use their documented SMTP host, port, user and
# password (NEVER commit real credentials). SMTP_SECURE=true means implicit
# TLS (port 465); use 587 + SMTP_SECURE=false for STARTTLS.
SMTP_HOST="REPLACE_ME_WITH_SMTP_HOST"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="REPLACE_ME_WITH_SMTP_USER"
SMTP_PASS="REPLACE_ME_WITH_SMTP_PASSWORD"
EMAIL_FROM="InternPath <no-reply@REPLACE_ME_WITH_YOUR_DOMAIN>"
# Public base URL used in email bodies (links back to the product).
PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (Phase 9/12 — fail-closed until configured)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Authorized JavaScript origins: the FRONTEND origin (e.g. http://localhost:3000)
# 4. Authorized redirect URI: the FRONTEND origin + the rewrite callback path —
#    P5 fix (2026-11-21): start and callback must traverse the SAME origin so
#    the state-binding cookie is attached to the callback. Default:
#      http://localhost:3000/api/backend/api/auth/google/callback
#    Production: https://<frontend-host>/api/backend/api/auth/google/callback
#    (split-host deployments use the Next.js rewrite; a backend-host callback
#    URI would fail state binding on every sign-in)
# 5. Paste the values below (NEVER commit real credentials). Leave
#    GOOGLE_REDIRECT_URI unset to use the FRONTEND_URL-derived default.
GOOGLE_CLIENT_ID="REPLACE_ME_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME_WITH_YOUR_GOOGLE_CLIENT_SECRET"
# GOOGLE_REDIRECT_URI="https://<frontend-host>/api/backend/api/auth/google/callback"

# ------------------------------------------------------------------
# Hosted deployment (Render) — deployment sprint 2026-11-22
# ------------------------------------------------------------------
# NODE_ENV=production enables a startup safety check (src/shared/config):
#   - FRONTEND_URL must be the exact https:// frontend origin (no trailing slash
#     needed; it is stripped). Example: https://<project>.vercel.app
#   - DATABASE_URL must NOT name internpath_dev or a *test* database. Use a
#     dedicated database. A deliberate exception requires:
# INTERNPATH_ALLOW_DEV_DATABASE="false"
# Render has no IPv6 egress: use the Supabase SESSION POOLER string
# (host aws-0-<region>.pooler.supabase.com, port 5432, user postgres.<ref>).
#
# Demo seeding of a hosted database (manual operator step, never automatic):
# requires INTERNPATH_ALLOW_DEMO_SEED=true AND fresh passwords (>= 12 chars);
# the committed dev defaults are refused when NODE_ENV=production.
# DEMO_ADMIN_PASSWORD="REPLACE_ME_FRESH_VALUE"
# DEMO_STUDENT_PASSWORD="REPLACE_ME_FRESH_VALUE"
# DEMO_MENTOR_PASSWORD="REPLACE_ME_FRESH_VALUE"
